    {
      "parameters": {
        "jsCode": "function cleanText(text) {\n  if (!text) return '';\n  // إزالة رموز markdown اللي ممكن تسبب مشكلة بتيليجرام\n  return text.replace(/[*_`\\[\\]]/g, '');\n}\n\nconst item = $input.first().json;\n\nreturn [{\n  json: {\n    ...item,\n    linkedin: cleanText(item.linkedin),\n    twitter: cleanText(item.twitter),\n    instagram: cleanText(item.instagram)\n  }\n}];"
      },
