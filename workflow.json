        "method": "POST",
        "url": "https://api.groq.com/openai/v1/chat/completions",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({\n  model: \"llama-3.3-70b-versatile\",\n  temperature: 0.7,\n  messages: [\n    {\n      role: \"system\",\n      content: \"You are a social media content repurposing expert. Given original content, output ONLY valid JSON (no markdown fences, no explanation) with exactly these keys: 'linkedin' (a professional post, 3-5 short paragraphs, include a call to action), 'twitter' (a single tweet under 280 characters, punchy tone), 'instagram' (an engaging caption with 3-5 relevant hashtags at the end). Write the output in the SAME language as the original content.\"\n    },\n    {\n      role: \"user\",\n      content: $json['Original Content']\n    }\n  ]\n}) }}",
        "options": {}
      },
      "id": "04663fb7-db64-434a-83dc-aac65a945d9a",
      "name": "Generate Repurposed Content",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        656,
        -64
      ]
    },
    {
      "parameters": {
        "jsCode": "const raw = $input.first().json.choices[0].message.content;\nlet cleaned = raw.trim();\ncleaned = cleaned.replace(/^```json\\s*/i, '').replace(/^```\\s*/i, '').replace(/```\\s*$/i, '');\n\nlet parsed;\ntry {\n  parsed = JSON.parse(cleaned);\n} catch (e) {\n  parsed = {\n    linkedin: 'PARSE ERROR - check raw output',\n    twitter: 'PARSE ERROR - check raw output',\n    instagram: 'PARSE ERROR - check raw output'\n  };\n}\n\nconst original = $('Content Input Form').first().json['Original Content'];\n\nreturn [{\n  json: {\n    original: original,\n    linkedin: parsed.linkedin || '',\n    twitter: parsed.twitter || '',\n    instagram: parsed.instagram || '',\n    generatedAt: new Date().toISOString()\n  }\n}];"
      },
